        {
          "name": "Duplicate Reading (409)",
          "description": "Self-contained: this request submits a reading with a unique meter number, then the test script submits the identical body twice (dynamic meter number) and asserts the second submission returns 409 DUPLICATE_RESOURCE.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const token = pm.collectionVariables.get('accessToken');",
                  "const duplicateBody = {",
                  "    meterNumber: 'MTR-DUP-' + Date.now(),",
                  "    billingMonth: 8,",
                  "    billingYear: 2026,",
                  "    previousReading: 1000.000,",
                  "    currentReading: 1100.000,",
                  "    readingDate: '2026-08-01'",
                  "};",
                  "",
                  "const submit = {",
                  "    url: baseUrl + '/api/meter-readings',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + token,",
                  "        'Content-Type': 'application/json'",
                  "    },",
                  "    body: { mode: 'raw', raw: JSON.stringify(duplicateBody) }",
                  "};",
                  "",
                  "pm.sendRequest(submit, function (err, res1) {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res1.code).to.eql(201);",
                  "",
                  "    pm.sendRequest(submit, function (err2, res2) {",
                  "        pm.expect(err2).to.be.null;",
                  "        pm.test('Second submission is 409 Conflict', function () {",
                  "            pm.expect(res2.code).to.eql(409);",
                  "        });",
                  "        pm.test('Error message contains duplicate', function () {",
                  "            const jsonData = res2.json();",
                  "            pm.expect(jsonData.error.code).to.eql('DUPLICATE_RESOURCE');",
                  "            pm.expect(jsonData.error.message).to.include('already exists');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
