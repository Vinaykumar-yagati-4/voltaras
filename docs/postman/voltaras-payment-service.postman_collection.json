    {
      "name": "Recharge & Wallet",
      "item": [
        {
          "name": "Create Recharge Order - UPI (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const jsonData = pm.response.json();",
                  "pm.test('Razorpay order created and references captured', function () {",
                  "    pm.expect(jsonData.orderId).to.not.be.undefined;",
                  "    pm.expect(jsonData.status).to.eql('CREATED');",
                  "    pm.expect(jsonData.razorpayKeyId).to.not.be.undefined;",
                  "    pm.collectionVariables.set('orderId', jsonData.orderId);",
                  "    pm.collectionVariables.set('rechargeReference', jsonData.rechargeReference);",
                  "    pm.collectionVariables.set('idempotencyKey', pm.request.headers.get('Idempotency-Key'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "recharge-upi-{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": {{organizationId}},\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/recharges/orders"
            }
          }
        },
        {
          "name": "Create Recharge Order - CARD (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
