        {
          "name": "Insufficient Wallet Balance (400)",
          "description": "Pay a bill larger than the wallet balance (or without a recharge). Expected error code: INSUFFICIENT_WALLET_BALANCE.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "const jsonData = pm.response.json();",
                  "pm.test('Error code is INSUFFICIENT_WALLET_BALANCE', function () {",
                  "    pm.expect(jsonData.error.code).to.eql('INSUFFICIENT_WALLET_BALANCE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "pay-insufficient-{{$guid}}" },
