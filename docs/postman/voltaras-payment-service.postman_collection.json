          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "recharge-card-{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": {{organizationId}},\n  \"amount\": 250.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\"\n}"
