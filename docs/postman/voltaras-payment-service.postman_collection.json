                  "    pm.expect(jsonData.status).to.eql('SUCCESS');",
                  "    pm.expect(jsonData.paymentReference).to.not.be.undefined;",
                  "    pm.expect(jsonData.paymentMethod).to.eql('WALLET');",
                  "    pm.collectionVariables.set('paymentId', String(jsonData.id));",
                  "    pm.collectionVariables.set('paymentReference', jsonData.paymentReference);",
                  "    pm.collectionVariables.set('idempotencyKey', pm.request.headers.get('Idempotency-Key'));",
                  "});"
                ]
