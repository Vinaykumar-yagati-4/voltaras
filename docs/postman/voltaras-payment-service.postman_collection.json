            "url": {
              "raw": "{{baseUrl}}/api/recharges/orders"
            }
          }
        },
        {
          "name": "Razorpay Webhook - payment.captured (200)",
          "description": "Simulates the Razorpay callback for the captured order ({{orderId}}). Public route (no JWT). The X-Razorpay-Signature header must be the HMAC-SHA256 (hex) of the exact raw body using RAZORPAY_WEBHOOK_SECRET. Fill the webhookSignature collection variable with a correctly computed value, or trigger the webhook from the Razorpay test dashboard.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Razorpay-Signature", "value": "{{webhookSignature}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"event\",\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_test_captured_1\",\n        \"order_id\": \"{{orderId}}\",\n        \"amount\": 50000,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhooks/razorpay"
            }
          }
        },
        {
          "name": "Repeat Same Webhook - Idempotent (200)",
          "description": "The identical callback is a no-op: still 200 and the wallet is NOT credited twice.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Razorpay-Signature", "value": "{{webhookSignature}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"event\",\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_test_captured_1\",\n        \"order_id\": \"{{orderId}}\",\n        \"amount\": 50000,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhooks/razorpay"
            }
          }
        },
