            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "pay-bill-{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": {{organizationId}},\n  \"amount\": 223.13,\n  \"currency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bills/{{billId}}/payments"
            }
          }
        },
        {
          "name": "Repeat Identical Request - No Duplicate (201 same reference)",
          "description": "Replays the exact same body with the same Idempotency-Key. The service returns the ORIGINAL payment, the wallet is NOT debited again, and no duplicate row is created.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const jsonData = pm.response.json();",
                  "pm.test('Same paymentReference returned (no duplicate)', function () {",
                  "    pm.expect(jsonData.paymentReference).to.eql(pm.collectionVariables.get('paymentReference'));",
                  "    pm.expect(String(jsonData.id)).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": {{organizationId}},\n  \"amount\": 223.13,\n  \"currency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bills/{{billId}}/payments"
            }
          }
        },
        {
          "name": "Reuse Key With Different Data (409)",
          "description": "The same Idempotency-Key with a different amount must return 409 IDEMPOTENCY_CONFLICT.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "const jsonData = pm.response.json();",
                  "pm.test('Error code is IDEMPOTENCY_CONFLICT', function () {",
                  "    pm.expect(jsonData.error.code).to.eql('IDEMPOTENCY_CONFLICT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": {{organizationId}},\n  \"amount\": 355.04,\n  \"currency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bills/{{billId}}/payments"
            }
          }
        }
      ]
    },
