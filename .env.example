# ============================================================
# VOLTARAS Backend — environment template
#
# Copy to .env and edit before running the stack:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.
# Values below are SAMPLES for local development only.
# ============================================================

# ---- MySQL -------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
# Host port for MySQL (change to 3307 if a local MySQL occupies 3306)
MYSQL_HOST_PORT=3306

# Application database user (created in MySQL + used by all services)
DB_USERNAME=voltaras
DB_PASSWORD=change-me-db-password

# ---- RabbitMQ ----------------------------------------------
RABBITMQ_DEFAULT_USER=voltaras
RABBITMQ_DEFAULT_PASS=change-me-rabbit-password
# Host ports (change if a local RabbitMQ occupies 5672/15672)
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- JWT ---------------------------------------------------
# Must be identical for api-gateway and auth-service.
# HS256 requires at least 32 bytes (256 bits).
JWT_SECRET=change-me-to-a-random-secret-of-at-least-64-characters-0123456789

# ---- CORS (API Gateway) ------------------------------------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# ---- Mail (auth-service password reset — optional) ---------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# smtp = real e-mail, console = print reset link to the log
PASSWORD_RESET_MAIL_PROVIDER=smtp

# ---- Payment (Razorpay sandbox) ----------------------------
# payment-service requires these three at startup.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
